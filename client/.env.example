# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> Credentials).
# Enable "YouTube Data API v3" on the project first.
# Powers the "Latest From The Channel" section on the homepage.
YOUTUBE_API_KEY=

# Optional. The channel's UC... id. Setting it saves an API call per refresh and
# is more robust than handle lookup. Leave blank to use the handle below.
YOUTUBE_CHANNEL_ID=

# Optional. Defaults to @PastorPilot.
YOUTUBE_CHANNEL_HANDLE=
